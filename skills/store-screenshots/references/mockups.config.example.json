      "shop": ["UN ARSENAL", "ABSURDE", "Tes armes frappent pour toi"],
      "feature": ["Tape, frappe, collectionne", "en 3D"]
    },
    "en": {
      "home": ["BONK THE", "MONSTERS!", "3D battles"],
      "collection": ["10 HEROES", "TO COLLECT", "Common to legendary"],
      "shop": ["AN ABSURD", "ARSENAL", "Your weapons fight for you"],
      "feature": ["Tap, bonk and collect", "in 3D"]
    }
