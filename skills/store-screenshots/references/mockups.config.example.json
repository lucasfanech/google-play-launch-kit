{
  "name": "My Game",
  "languages": ["fr", "en"],
  "raw": "store/raw",
  "out": "store/play",
  "icon": "assets/images/icon.png",
  "fonts": {
    "display": "node_modules/@expo-google-fonts/lilita-one/400Regular/LilitaOne_400Regular.ttf",
    "body": "node_modules/@expo-google-fonts/fredoka/700Bold/Fredoka_700Bold.ttf"
  },
  "theme": {
    "ink": "#1B2140",
    "bg1": "#FF9B1F", "bg2": "#F78502", "bg3": "#E86F00",
